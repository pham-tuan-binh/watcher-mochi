menu "Mochi"

    config MOCHI_DEEP_SLEEP_TIMEOUT_SEC
        int "Deep sleep inactivity timeout (seconds)"
        range 30 3600
        default 300
        help
            Seconds of inactivity before the device enters deep sleep.
            Default is 300 (5 minutes).

    config MOCHI_POND_KOI_COUNT
        int "Number of koi in the pond"
        range 1 8
        default 3
        help
            How many koi to simulate at boot. They cycle through three
            colourways, and roam past the rim, so the number visible on
            screen drifts either side of this. Changeable at runtime with
            pond_set_population().

    config MOCHI_POND_LILY_COUNT
        int "Number of lily pads"
        range 0 12
        default 5
        help
            How many lily pads to simulate at boot. They are scattered
            randomly on every boot and drift around afterwards. Set to 0
            for open water.

    config MOCHI_POND_MOTE_COUNT
        int "Number of drifting motes"
        range 0 16
        default 7
        help
            Faint glowing specks drifting over the surface. Set to 0 to
            turn them off.

endmenu
